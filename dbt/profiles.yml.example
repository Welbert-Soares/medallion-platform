# Copy to ~/.dbt/profiles.yml and fill in your credentials.
# One profile per dbt project — profile name must match the project name in dbt_project.yml.
# Never commit this file with real values.

utils:
  target: dev
  outputs:
    dev:
      type: databricks
      host: <workspace>.azuredatabricks.net
      http_path: /sql/1.0/warehouses/12ca72db06431bb2
      token: <personal-access-token>
      catalog: medallion_bronze
      schema: weather
      threads: 4

