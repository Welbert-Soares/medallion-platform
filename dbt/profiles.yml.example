# Copy to ~/.dbt/profiles.yml and fill in your credentials. Never commit it with real values.
# One profile, named after the single dbt project (dbt_project.yml: profile 'medallion').
# Models set their own catalog and schema (ADR 0006); catalog/schema here are only the defaults.
#
#   cd dbt && dbt build --select tag:weather    # one Source System, bronze → silver → gold

medallion:
  target: dev
  outputs:
    dev:
      type: databricks
      host: <workspace>.azuredatabricks.net
      http_path: /sql/1.0/warehouses/12ca72db06431bb2
      token: <personal-access-token>
      catalog: medallion_bronze
      schema: weather
      threads: 4
